#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<'HELP'
Configuration Manager CLI

Usage:
  civicfg export [options]
  civicfg import [options]
  civicfg diff [options]
  civicfg validate [options]
  civicfg watch [options]
  civicfg status
  civicfg scope [--json]
  civicfg scope-items --type TYPE [--json]
  civicfg scope-set --type TYPE --mode MODE [scope options]
  civicfg cross-site-import [--allow|--deny] [--json]
  civicfg qa-browser --base-url URL [qa options]
  civicfg qa-browser-clean [--yes]

Common options:
  --type TYPE       Limit to a config type. Repeat for export/import/diff/validate/watch.
  --dry-run         Preview only. Default for import; optional for export.
  --write           Write YAML files for export.
  --yes, -y         Apply import or answer yes where supported.
  --json            Ask cv for JSON output when supported.
  -h, --help        Show this help.

Scope options:
  --mode MODE       all, selected, watch, or ignore.
  --selector VALUE  Selected-scope selector. Repeat for multiple items.
  --watch-unmanaged Monitor unselected items when mode=selected.

Cross-site options:
  --allow           Enable reviewed cross-site import.
  --deny            Disable cross-site import.

Browser QA options:
  --base-url URL    Authorized DEV/disposable CiviCRM base URL.
  --admin-user USER Browser login user (default: CIVICRM_ADMIN_USER or admin).
  --tool-dir DIR    External Playwright-PHP tool cache/workspace.
  --artifact-dir DIR Directory for browser QA artifacts.
  --clean-legacy    Remove the old generated tests/browser-php/vendor first.

Browser QA password:
  Set CIVICRM_ADMIN_PASS in the environment. Passwords are intentionally not
  accepted as command-line arguments so they do not leak through process lists.

Examples:
  civicfg export --write
  civicfg import --dry-run
  civicfg import --yes
  civicfg validate
  civicfg watch
  civicfg scope --json
  civicfg scope-items --type message-templates --json
  civicfg scope-set --type message-templates --mode selected --selector 'key:message-templates|workflow_name=contribution_online_receipt|is_default=0' --watch-unmanaged
  civicfg cross-site-import
  civicfg cross-site-import --allow
  civicfg qa-browser --base-url https://dev.example.test
  civicfg qa-browser --base-url https://dev.example.test --clean-legacy
  civicfg qa-browser-clean --yes
HELP
}

json_array() {
  php -r 'echo json_encode(array_slice($argv, 1));' "$@"
}

fail() {
  echo "$1" >&2
  exit 2
}

if [[ $# -eq 0 ]]; then
  show_help
  exit 2
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  show_help
  exit 0
fi

command="$1"
shift || true

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
legacy_browser_vendor="${repo_root}/tests/browser-php/vendor"
browser_runner="${repo_root}/tests/ci/run-browser-php.sh"

if [[ "$command" == "qa-browser-clean" ]]; then
  confirm="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) confirm="1" ;;
      -h|--help)
        cat <<'HELP'
Usage: civicfg qa-browser-clean [--yes]

Removes only generated legacy Playwright-PHP artifacts created under
tests/browser-php by the pre-Alpha67.1 workflow. Without --yes this is a
read-only preview.
HELP
        exit 0
        ;;
      *) fail "Unknown qa-browser-clean option: $1" ;;
    esac
    shift || true
  done

  targets=()
  [[ -d "$legacy_browser_vendor" ]] && targets+=("$legacy_browser_vendor")
  [[ -f "${repo_root}/tests/browser-php/.phpunit.result.cache" ]] && targets+=("${repo_root}/tests/browser-php/.phpunit.result.cache")
  [[ -d "${repo_root}/tests/browser-php/.phpunit.cache" ]] && targets+=("${repo_root}/tests/browser-php/.phpunit.cache")

  if [[ ${#targets[@]} -eq 0 ]]; then
    echo "No legacy browser-QA artifacts found."
    exit 0
  fi
  printf 'Legacy browser-QA artifact(s):\n'
  printf '  %s\n' "${targets[@]}"
  if [[ "$confirm" != "1" ]]; then
    echo "Preview only. Re-run with --yes to remove these generated artifacts."
    exit 0
  fi
  rm -rf -- "${targets[@]}"
  echo "Legacy browser-QA artifacts removed."
  exit 0
fi

if [[ "$command" == "qa-browser" ]]; then
  base_url="${CIVICFG_BASE_URL:-}"
  admin_user="${CIVICRM_ADMIN_USER:-admin}"
  tool_dir="${CIVICFG_BROWSER_PHP_TOOL_DIR:-}"
  artifact_dir="${QA_ARTIFACT_DIR:-}"
  clean_legacy="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base-url) shift; [[ $# -gt 0 ]] || fail "Missing value for --base-url"; base_url="$1" ;;
      --base-url=*) base_url="${1#--base-url=}" ;;
      --admin-user) shift; [[ $# -gt 0 ]] || fail "Missing value for --admin-user"; admin_user="$1" ;;
      --admin-user=*) admin_user="${1#--admin-user=}" ;;
      --tool-dir) shift; [[ $# -gt 0 ]] || fail "Missing value for --tool-dir"; tool_dir="$1" ;;
      --tool-dir=*) tool_dir="${1#--tool-dir=}" ;;
      --artifact-dir) shift; [[ $# -gt 0 ]] || fail "Missing value for --artifact-dir"; artifact_dir="$1" ;;
      --artifact-dir=*) artifact_dir="${1#--artifact-dir=}" ;;
      --clean-legacy) clean_legacy="1" ;;
      -h|--help)
        cat <<'HELP'
Usage: civicfg qa-browser --base-url URL [options]

Options:
  --base-url URL       Authorized DEV/disposable CiviCRM site.
  --admin-user USER    Login user. Password comes from CIVICRM_ADMIN_PASS.
  --tool-dir DIR       External Playwright-PHP tooling directory.
  --artifact-dir DIR   Browser QA artifact directory.
  --clean-legacy       Remove old generated tests/browser-php/vendor first.

This command does not require cv and may be run from any directory when using
the installed civicfg launcher.
HELP
        exit 0
        ;;
      --admin-pass|--admin-pass=*) fail "Do not pass passwords on the command line; set CIVICRM_ADMIN_PASS in the environment." ;;
      *) fail "Unknown qa-browser option: $1" ;;
    esac
    shift || true
  done

  [[ -n "$base_url" ]] || fail "qa-browser requires --base-url URL (or CIVICFG_BASE_URL)."
  [[ -x "$browser_runner" ]] || fail "Browser QA runner is missing or not executable: $browser_runner"

  if [[ -d "$legacy_browser_vendor" ]]; then
    if [[ "$clean_legacy" == "1" ]]; then
      rm -rf -- "$legacy_browser_vendor"
      rm -f -- "${repo_root}/tests/browser-php/.phpunit.result.cache"
      rm -rf -- "${repo_root}/tests/browser-php/.phpunit.cache"
      echo "Removed legacy tests/browser-php/vendor before browser QA."
    else
      fail "Legacy tests/browser-php/vendor exists. Run 'civicfg qa-browser-clean --yes' or add --clean-legacy."
    fi
  fi

  export CIVICFG_BASE_URL="$base_url"
  export CIVICRM_ADMIN_USER="$admin_user"
  [[ -z "$tool_dir" ]] || export CIVICFG_BROWSER_PHP_TOOL_DIR="$tool_dir"
  [[ -z "$artifact_dir" ]] || export QA_ARTIFACT_DIR="$artifact_dir"
  exec bash "$browser_runner"
fi

cv_cmd="${CIVICFG_CV:-}"
if [[ -z "${cv_cmd}" ]]; then
  cv_cmd="$(command -v cv || true)"
fi
if [[ -z "${cv_cmd}" ]]; then
  fail "Configuration Manager CLI requires the CiviCRM cv command."
fi

types=()
selectors=()
dry_run=""
yes="0"
json="0"
mode=""
watch_unmanaged="0"
cross_allow="0"
cross_deny="0"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      shift
      [[ $# -gt 0 ]] || fail "Missing value for --type"
      types+=("$1")
      ;;
    --type=*)
      types+=("${1#--type=}")
      ;;
    --selector)
      shift
      [[ $# -gt 0 ]] || fail "Missing value for --selector"
      selectors+=("$1")
      ;;
    --selector=*)
      selectors+=("${1#--selector=}")
      ;;
    --mode)
      shift
      [[ $# -gt 0 ]] || fail "Missing value for --mode"
      mode="$1"
      ;;
    --mode=*)
      mode="${1#--mode=}"
      ;;
    --watch-unmanaged)
      watch_unmanaged="1"
      ;;
    --allow)
      cross_allow="1"
      ;;
    --deny)
      cross_deny="1"
      ;;
    --dry-run)
      dry_run="1"
      ;;
    --write)
      dry_run="0"
      ;;
    --yes|-y)
      yes="1"
      dry_run="0"
      ;;
    --json)
      json="1"
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
  shift || true
done

cv_args=()
if [[ "$json" == "1" ]]; then
  cv_args+=(--out=json)
fi

type_json="[]"
if [[ ${#types[@]} -gt 0 ]]; then
  type_json=$(json_array "${types[@]}")
fi

selector_json="[]"
if [[ ${#selectors[@]} -gt 0 ]]; then
  selector_json=$(json_array "${selectors[@]}")
fi

case "$command" in
  export)
    [[ -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" ]] || fail "Scope/cross-site options are not valid for export."
    [[ -n "$dry_run" ]] || dry_run="0"
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.export dryRun="$dry_run" type="$type_json"
    ;;
  import)
    [[ -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" ]] || fail "Scope/cross-site options are not valid for import."
    [[ -n "$dry_run" ]] || dry_run="1"
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.import dryRun="$dry_run" yes="$yes" type="$type_json"
    ;;
  diff)
    [[ -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" ]] || fail "Scope/cross-site options are not valid for diff."
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.diff type="$type_json"
    ;;
  validate)
    [[ -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" ]] || fail "Scope/cross-site options are not valid for validate."
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.validate type="$type_json"
    ;;
  watch)
    [[ -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" ]] || fail "Scope/cross-site options are not valid for watch."
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.watch type="$type_json"
    ;;
  status)
    [[ ${#types[@]} -eq 0 && -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" && -z "$dry_run" && "$yes" == "0" ]] || fail "status accepts only --json."
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.status
    ;;
  scope)
    [[ ${#types[@]} -eq 0 && -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" && -z "$dry_run" && "$yes" == "0" ]] || fail "scope accepts only --json."
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.scopeGet
    ;;
  scope-items)
    [[ ${#types[@]} -eq 1 ]] || fail "scope-items requires exactly one --type."
    [[ -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && "$cross_allow" == "0" && "$cross_deny" == "0" && -z "$dry_run" && "$yes" == "0" ]] || fail "scope-items accepts only --type and --json."
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.scopeItems type="${types[0]}"
    ;;
  scope-set)
    [[ ${#types[@]} -eq 1 ]] || fail "scope-set requires exactly one --type."
    [[ "$mode" == "all" || "$mode" == "selected" || "$mode" == "watch" || "$mode" == "ignore" ]] || fail "scope-set requires --mode all|selected|watch|ignore."
    [[ "$cross_allow" == "0" && "$cross_deny" == "0" && -z "$dry_run" && "$yes" == "0" ]] || fail "scope-set does not accept import/export options."
    if [[ "$mode" != "selected" && ( ${#selectors[@]} -gt 0 || "$watch_unmanaged" == "1" ) ]]; then
      fail "--selector and --watch-unmanaged require --mode selected."
    fi
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.scopeSet type="${types[0]}" mode="$mode" selectors="$selector_json" watchUnmanaged="$watch_unmanaged"
    ;;
  cross-site-import)
    [[ ${#types[@]} -eq 0 && -z "$mode" && ${#selectors[@]} -eq 0 && "$watch_unmanaged" == "0" && -z "$dry_run" && "$yes" == "0" ]] || fail "cross-site-import accepts only --allow, --deny, and --json."
    [[ "$cross_allow" == "0" || "$cross_deny" == "0" ]] || fail "Choose either --allow or --deny, not both."
    if [[ "$cross_allow" == "1" ]]; then
      exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.crossSiteSet allowed=1
    fi
    if [[ "$cross_deny" == "1" ]]; then
      exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.crossSiteSet allowed=0
    fi
    exec "${cv_cmd}" "${cv_args[@]}" api4 ConfigManager.crossSiteStatus
    ;;
  *)
    echo "Unknown command: $command" >&2
    show_help
    exit 2
    ;;
esac
