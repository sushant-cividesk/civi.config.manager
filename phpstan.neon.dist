parameters:
  # Keep this strict enough to catch real regressions, but avoid blocking early
  # CI on legacy/API facade symbols which are only fully available inside a
  # bootstrapped CiviCRM runtime.
  level: 5
  bootstrapFiles:
    - tests/phpunit/bootstrap.php
  paths:
    - Civi/ConfigManager/Util
    - Civi/ConfigManager/Storage
    - Civi/ConfigManager/Version.php
    - tests/phpunit/Unit
  tmpDir: .phpstan-cache
  treatPhpDocTypesAsCertain: false
