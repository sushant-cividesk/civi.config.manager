parameters:
  # Keep this strict enough to catch real regressions, but avoid blocking early
  # CI on legacy/API facade symbols which are only fully available inside a
  # bootstrapped CiviCRM runtime.
  level: 5
  bootstrapFiles:
    - tests/phpunit/bootstrap.php
  # Source-contract helper is loaded inside PHPUnit test methods, which
  # PHPStan cannot follow statically. Discover its global function without
  # executing this test-only helper during analysis.
  scanFiles:
    - tests/ci/source-contract-reader.php
  paths:
    - Civi/ConfigManager/Util
    - Civi/ConfigManager/Storage
    - Civi/ConfigManager/Version.php
  tmpDir: .phpstan-cache
  treatPhpDocTypesAsCertain: false
