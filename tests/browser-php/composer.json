{
  "name": "civi-config-manager/browser-php-qa",
  "description": "Isolated PHP 8.2+ Playwright black-box QA for Configuration Manager.",
  "type": "project",
  "require-dev": {
    "php": "^8.2",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "playwright-php/playwright": "1.4.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Civi\\ConfigManager\\BrowserQa\\": "src/",
      "Civi\\ConfigManager\\BrowserQa\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
