{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sushant-cividesk/civi-config-manager",
    "description": "CiviCRM Configuration Manager extension development and QA tooling.",
    "type": "civicrm-ext",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=7.4",
        "symfony/yaml": "^5.4.54 || ^6.4.45 || ^7.4.18"
    },
    "require-dev": {
        "michaelmcandrew/civicrm-coding-standards": "^1.1.1",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Civi\\Api4\\": "Civi/Api4/",
            "Civi\\ConfigManager\\": "Civi/ConfigManager/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Civi\\ConfigManager\\Tests\\": "tests/phpunit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "lint:php": "bash tests/ci/php-lint.sh",
        "lint:architecture-contracts": [
            "php tests/ci/alpha62-contract.php",
            "php tests/ci/alpha63-contract.php",
            "php tests/ci/alpha64-contract.php"
        ],
        "lint:scenario-docs": "php tests/ci/validate-scenarios.php",
        "test:audit-wrapper": "bash tests/ci/composer-audit-wrapper-test.sh",
        "test:mutation-provider-inventory": "bash tests/ci/mutation-provider-inventory.sh",
        "test:alpha62-contract": "php tests/ci/alpha62-contract.php",
        "test:scenarios": "@lint:scenario-docs",
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "test:ml001:pending": "phpunit --configuration phpunit.xml.dist tests/pending/ml001/MultilingualAfformCanonicalizationTest.php",
        "test:hook": "phpunit --configuration phpunit.xml.dist --filter EntityDefinitionHandlerTest",
        "test:cli": "phpunit --configuration phpunit.xml.dist --filter '/(CliInstallerTest|CliCommandTest)/'",
        "analyse": "PHPSTAN_TURBO=0 phpstan analyse --configuration phpstan.neon.dist --no-progress",
        "standards": "phpcs --standard=phpcs.xml.dist",
        "compatibility7.4": "phpcs --standard=PHPCompatibility --extensions=php,module,inc,install --ignore=vendor,node_modules,.phpstan-cache,*/tests/ci/bundle2-write-accounting-smoke.php --runtime-set testVersion 7.4 CRM Civi configmanager.php settings tests",
        "compatibility8.1": "phpcs --standard=PHPCompatibility --extensions=php,module,inc,install --ignore=vendor,node_modules,.phpstan-cache,*/tests/ci/bundle2-write-accounting-smoke.php --runtime-set testVersion 8.1 CRM Civi configmanager.php settings tests",
        "compatibility8.3": "phpcs --standard=PHPCompatibility --extensions=php,module,inc,install --ignore=vendor,node_modules,.phpstan-cache,*/tests/ci/bundle2-write-accounting-smoke.php --runtime-set testVersion 8.3 CRM Civi configmanager.php settings tests",
        "qa:fast": [
            "@test:composer-script-refs",
            "@test:source-hygiene",
            "@test:source-hygiene-behavior",
            "@test:refactor-boundaries",
            "@test:sync-state-health",
            "@test:refactor-composition",
            "@test:mutation-targets",
            "@test:bundle2-write-accounting",
            "@test:php74-signatures",
            "@test:js-scope-composition",
            "@lint:php",
            "@lint:architecture-contracts",
            "@lint:scenario-docs",
            "@test:audit-wrapper",
            "@test:alpha68-ui",
            "@test:alpha68-lifecycle-state",
            "@test:lifecycle-state-behavior",
            "@test:unit",
            "@test:mutation-provider-inventory",
            "@test:mutation-provider-admission",
            "@test:mutation-import-plan",
            "@test:mutation-reduced-import",
            "@test:mutation-import-accounting",
            "@test:drupal-login-resolver",
            "@test:browser-workflow-contract",
            "@test:provider-browser",
            "@test:mutation-provider-browser",
            "@standards",
            "@analyse",
            "@compatibility7.4",
            "@compatibility8.0",
            "@compatibility8.3"
        ],
        "qa:real-runtime": "RUN_UI_TESTS=false bash tests/ci/run-standalone.sh",
        "qa:real-runtime-ui": "bash tests/ci/run-local-ui.sh",
        "qa:full": "@qa:real-runtime",
        "qa:full-ui": "@qa:real-runtime-ui",
        "qa:stress": [
            "php -d memory_limit=256M tests/ci/alpha62-stress.php",
            "php -d memory_limit=256M tests/ci/alpha63-stress.php"
        ],
        "test:alpha63-contract": "php tests/ci/alpha63-contract.php",
        "test:alpha64-contract": "php tests/ci/alpha64-contract.php",
        "package:release": "bash scripts/build-release.sh",
        "qa:browser": "RUN_UI_TESTS=true bash tests/ci/run-standalone.sh",
        "test:mutation-provider-admission": "bash tests/ci/mutation-provider-admission.sh",
        "test:source-hygiene": "CIVICFG_LOCAL_QA=1 bash tests/ci/source-hygiene.sh",
        "test:source-hygiene-behavior": "bash tests/ci/source-hygiene-behavior-test.sh",
        "test:refactor-boundaries": "php tests/ci/refactor-boundaries-smoke.php",
        "test:sync-state-health": "php tests/ci/sync-state-health-smoke.php",
        "test:refactor-composition": "php tests/ci/refactor-composition-smoke.php",
        "test:mutation-targets": "bash tests/ci/mutation-targets-smoke.sh",
        "test:php74-signatures": "php tests/ci/php74-signatures-smoke.php",
        "test:js-scope-composition": "node tests/ci/configmanager-scope-composition-test.js",
        "test:browser-workflow-contract": "php tests/ci/browser-workflow-contract.php",
        "test:provider-browser": "node tests/ci/provider-browser-test.js",
        "test:alpha68-ui": "php tests/ci/alpha68-ui-behavior.php",
        "test:drupal-login-resolver": "node tests/ci/drupal-login-url-test.js",
        "test:alpha68-lifecycle-state": "php tests/ci/alpha68-lifecycle-state.php",
        "test:lifecycle-state-behavior": "php tests/ci/lifecycle-state-behavior.php",
        "test:mutation-provider-browser": "bash tests/ci/mutation-provider-browser.sh",
        "test:mutation-import-plan": "bash tests/ci/mutation-import-plan.sh",
        "test:mutation-reduced-import": "bash tests/ci/mutation-reduced-import.sh",
        "test:mutation-import-accounting": "bash tests/ci/mutation-import-accounting.sh",
        "test:composer-script-refs": "php tests/ci/composer-script-references-smoke.php",
        "test:bundle2-write-accounting": "php tests/ci/bundle2-write-accounting-smoke.php",
        "compatibility8.0": "phpcs --standard=PHPCompatibility --extensions=php,module,inc,install --ignore=vendor,node_modules,.phpstan-cache,*/tests/ci/bundle2-write-accounting-smoke.php --runtime-set testVersion 8.0 CRM Civi configmanager.php settings tests"
    }
}
